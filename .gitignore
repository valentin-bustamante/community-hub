# Dependencias (en cualquier aplicación)
node_modules/
.pnp.*

# Variables y configuración local; las plantillas sin secretos se versionan
.env
.env.*
!.env.example
!.env.*.example

# Next.js y compilaciones
.next/
out/
build/
dist/
*.tsbuildinfo

# Strapi: cachés, estado local y subidas generadas
.cache/
.tmp/
.strapi/
.strapi-updater.json
backend/.strapi-cloud.json
backend/public/uploads/*
!backend/public/uploads/.gitkeep

# Datos locales: colocar aquí bases de desarrollo, no migraciones
backend/data/*.db
backend/data/*.db-*
backend/data/*.sqlite
backend/data/*.sqlite-*
backend/data/*.sqlite3
backend/data/*.sqlite3-*

# Pruebas y logs
coverage/
playwright-report/
test-results/
*.log

# Sistema y herramientas locales
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.vercel/
